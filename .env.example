# Copy to .env and fill in. .env is gitignored; never commit real secrets.

TACTIX_APP_NAME=TactiX
TACTIX_ENVIRONMENT=local

# PostgreSQL — matches the defaults in compose.yaml
TACTIX_DATABASE_URL=postgresql+psycopg://tactix:tactix@localhost:5432/tactix

# Model provider. Selects which adapter builds the (provider-neutral) MAF chat client.
# "foundry" is the adapter wired today; others register under their own name in code.
TACTIX_MODEL_PROVIDER=foundry

# Execution bounds for the model-backed stages (apply to whichever provider is selected).
TACTIX_MODEL_TIMEOUT_SECONDS=30
TACTIX_MODEL_MAX_ATTEMPTS=2
TACTIX_MODEL_MAX_TOOL_CALLS=8
TACTIX_MODEL_MAX_ITERATIONS=5
TACTIX_MODEL_MAX_TOKENS=2048

# Microsoft Foundry adapter (only used when TACTIX_MODEL_PROVIDER=foundry).
# Project inference uses Entra authentication, not an API key.
# Example: https://RESOURCE.services.ai.azure.com/api/projects/PROJECT
TACTIX_FOUNDRY_ENDPOINT=
TACTIX_FOUNDRY_MODEL=
TACTIX_FOUNDRY_AUTHENTICATION=cli

TACTIX_DEFAULT_LANGUAGE=en
