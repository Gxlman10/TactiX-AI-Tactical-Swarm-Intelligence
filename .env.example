# Copy to .env and fill in. .env is gitignored; never commit real secrets.

TACTIX_APP_NAME=TactiX
TACTIX_ENVIRONMENT=local

# PostgreSQL — matches the defaults in compose.yaml
TACTIX_DATABASE_URL=postgresql+psycopg://tactix:tactix@localhost:5432/tactix

# Microsoft Foundry — fill once the model deployment exists in the account
TACTIX_FOUNDRY_ENDPOINT=
TACTIX_FOUNDRY_API_KEY=
TACTIX_FOUNDRY_MODEL=

TACTIX_DEFAULT_LANGUAGE=en
