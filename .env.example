# Copy to .env and fill in. .env is gitignored; never commit real secrets.

TACTIX_APP_NAME=TactiX
TACTIX_ENVIRONMENT=local

# PostgreSQL — matches the defaults in compose.yaml
TACTIX_DATABASE_URL=postgresql+psycopg://tactix:tactix@localhost:5432/tactix

# Microsoft Foundry project inference — Entra authentication, not an API key
# Example: https://RESOURCE.services.ai.azure.com/api/projects/PROJECT
TACTIX_FOUNDRY_ENDPOINT=
# Reserved legacy field; not used by the project-based MAF adapter.
TACTIX_FOUNDRY_API_KEY=
TACTIX_FOUNDRY_MODEL=
TACTIX_FOUNDRY_AUTHENTICATION=cli
TACTIX_FOUNDRY_TIMEOUT_SECONDS=30
TACTIX_FOUNDRY_MAX_ATTEMPTS=2
TACTIX_FOUNDRY_MAX_TOOL_CALLS=8
TACTIX_FOUNDRY_MAX_ITERATIONS=5
TACTIX_FOUNDRY_MAX_TOKENS=2048

TACTIX_DEFAULT_LANGUAGE=en
